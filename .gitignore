# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example


# reels: footage, music, renders and caches stay on the machine
/reels/.venv/
/reels/cache/
/reels/out/
/reels/inbox/media/*
/reels/inbox/music/*
!/reels/inbox/media/.gitkeep
!/reels/inbox/music/.gitkeep
__pycache__/
